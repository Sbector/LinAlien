---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Obra 3D / AR">
  <model-viewer
    src="/Berg.glb"
    ios-src="/Berg.usdz"
    ar
    ar-modes="webxr scene-viewer quick-look"
    ar-placement="floor"
    ar-scale="fixed"
    camera-controls
    auto-rotate
    poster="/poster.svg"
    shadow-intensity="1"
    environment-image="neutral"
    exposure="1"
    reveal="auto"
    loading="eager"
    scale="0.001"
  >
    <div class="progress-bar" slot="progress-bar"></div>
    <div slot="ar-button">
      <button class="custom-ar-button" aria-label="Activar Realidad Aumentada">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <span>Ver en AR</span>
      </button>
    </div>
    <div slot="ar-prompt">
      <p>Muévete para encontrar una superficie plana</p>
    </div>
    <div slot="ar-not-supported">
      <p>Tu dispositivo no soporta AR. Puedes inspeccionar el modelo en 3D.</p>
    </div>
  </model-viewer>
</Layout>
