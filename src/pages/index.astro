---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import razas from '../data/razas.json';

const tituloOficial = 'LISTA DE RAZAS EXTRATERRESTRES QUE COOPERAN CON EL COMPLEJO MILITAR E INDUSTRIAL';
const subtituloOficial = 'ARCHIVO DE RAZAS EXTRATERRESTRES';
const instruccion = 'SELECCIONA UNA RAZA PARA CONSULTAR SU ARCHIVO';
---

<Layout title="MURA · Catálogo de Razas">
  <header class="header" role="banner">
    <span class="header-mura">MURA</span>
    <span class="header-exposicion">EXPOSICIÓN</span>
    <h1 class="titulo-obra titulo-oficial">{tituloOficial}</h1>
    <p class="subtitulo-oficial">{subtituloOficial}</p>
  </header>

  <main>
    <div class="catalogo-grid" role="list">
      {razas.map((raza) => (
        <article class="tarjeta" role="listitem">
          <a href={`/razas/${raza.slug}`} aria-label={`Ver ficha de ${raza.nombre}`}>
            <div class="tarjeta-img-wrapper">
              <img
                class="tarjeta-img"
                src={raza.imageSrc}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="tarjeta-nombre">
              <span class="nombre-raza">{raza.nombre}</span>
            </div>
          </a>
        </article>
      ))}
    </div>
    <p class="instruccion-catalogo">{instruccion}</p>
  </main>
</Layout>