---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Obra 3D / AR">
  <model-viewer
    src="/Berg.glb"
    ios-src="/Berg.usdz"
    ar
    ar-modes="webxr scene-viewer quick-look"
    ar-placement="floor"
    ar-scale="fixed"
    camera-controls
    auto-rotate
    poster="/poster.svg"
    shadow-intensity="1"
    environment-image="neutral"
    exposure="1"
  >
    <div class="progress-bar" slot="progress-bar"></div>
    <div slot="ar-prompt">
      <p>Muévete para encontrar una superficie plana</p>
    </div>
    <div slot="ar-not-supported">
      <p>Tu dispositivo no soporta AR. Puedes inspeccionar el modelo en 3D.</p>
    </div>
  </model-viewer>
</Layout>
