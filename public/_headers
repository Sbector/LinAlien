# Netlify Headers for CORS and Caching

/AlienGris.glb
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/AlienGris.usdz
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/textures/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/*.glb
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/*.usdz
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable
